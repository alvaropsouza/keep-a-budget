DATABASE_URL=postgresql://admin:password@localhost:5432/road_of_life
# Required. 32 bytes as 64 hex chars. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
PORT=3000
HOST=0.0.0.0
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_NAME=road-of-life-receipts
MAX_FILE_SIZE_MB=5
LOG_LEVEL=info
NODE_ENV=development
FRONTEND_URL=https://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
ALLOWED_ORIGIN_PATTERNS=

# Set to "true" only to allow new user registrations (default: closed)
REGISTRATION_OPEN=false

# Required for login: OTP codes are sent by email via Resend.
RESEND_API_KEY=re_...

ANTHROPIC_API_KEY=sk-ant-...
