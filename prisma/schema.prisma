generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
}

model User {
    id           String         @id @default(uuid()) @db.Uuid
    name         String
    lastName     String         @map("last_name")
    email        String         @unique
    phone        String?
    salary       Decimal?       @db.Decimal(12, 2)
    avatar       String?
    lastLogin    DateTime?      @map("last_login")
    createdAt    DateTime       @default(now()) @map("created_at")
    updatedAt    DateTime       @updatedAt @map("updated_at")
    fixedExpense FixedExpense[]

    @@map("users")
}

model CardInvoice {
    id          String    @id @default(uuid()) @db.Uuid
    bank        String
    closingDate DateTime  @map("closing_date") @db.Date
    dueDate     DateTime  @map("due_date") @db.Date
    balance     Decimal   @default(0) @db.Decimal(12, 2)
    advance     Decimal   @default(0) @db.Decimal(12, 2)
    isClosed    Boolean   @default(false) @map("is_closed")
    createdAt   DateTime  @default(now()) @map("created_at")
    updatedAt   DateTime  @updatedAt @map("updated_at")
    expenses    Expense[]

    @@unique([bank, closingDate], map: "card_invoices_bank_closing_date_unique")
    @@map("card_invoices")
}

model Expense {
    id                 String       @id @default(uuid()) @db.Uuid
    bank               String
    type               String
    category           String
    date               DateTime     @db.Date
    amount             Decimal      @db.Decimal(12, 2)
    description        String?
    receipt            String?
    installmentCurrent Int?         @map("installment_current")
    installmentTotal   Int?         @map("installment_total")
    cardInvoiceId      String?      @map("card_invoice_id") @db.Uuid
    cardInvoice        CardInvoice? @relation(fields: [cardInvoiceId], references: [id], onDelete: SetNull)
    createdAt          DateTime     @default(now()) @map("created_at")
    updatedAt          DateTime     @updatedAt @map("updated_at")

    @@map("expenses")
}

model FixedExpense {
    id          String   @id @default(uuid()) @db.Uuid
    userId      String?  @map("user_id") @db.Uuid
    user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
    name        String
    amount      Decimal  @db.Decimal(12, 2)
    description String?
    dueDay      Int?     @map("due_day")
    isActive    Boolean  @default(true) @map("is_active")
    createdAt   DateTime @default(now()) @map("created_at")
    updatedAt   DateTime @updatedAt @map("updated_at")

    @@index([userId, isActive], map: "fixed_expenses_user_id_is_active_idx")
    @@map("fixed_expenses")
}
