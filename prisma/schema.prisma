generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma/client"
}

datasource db {
    provider = "postgresql"
}

model User {
    id           String         @id @default(uuid()) @db.Uuid
    name         String
    lastName     String         @map("last_name")
    email        String         @unique
    cpf          String?        @unique @db.VarChar(11)
    rg           String?        @unique @db.VarChar(20)
    passwordHash String?        @map("password_hash")
    phone        String?
    salary       Decimal?       @db.Decimal(12, 2)
    avatar       String?
    lastLogin    DateTime?      @map("last_login")
    createdAt    DateTime       @default(now()) @map("created_at")
    updatedAt    DateTime       @updatedAt @map("updated_at")
    fixedExpense FixedExpense[]
    sessions     UserSession[]
    expenses     Expense[]
    cardInvoices CardInvoice[]

    @@map("users")
}

model UserSession {
    id        String    @id @default(uuid()) @db.Uuid
    userId    String    @map("user_id") @db.Uuid
    user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    tokenHash String    @unique @map("token_hash")
    expiresAt DateTime  @map("expires_at")
    revokedAt DateTime? @map("revoked_at")
    createdAt DateTime  @default(now()) @map("created_at")
    updatedAt DateTime  @updatedAt @map("updated_at")

    @@index([userId], map: "user_sessions_user_id_idx")
    @@index([expiresAt], map: "user_sessions_expires_at_idx")
    @@map("user_sessions")
}

model CardInvoice {
    id          String    @id @default(uuid()) @db.Uuid
    userId      String    @map("user_id") @db.Uuid
    user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    bank        String
    closingDate DateTime  @map("closing_date") @db.Date
    dueDate     DateTime  @map("due_date") @db.Date
    balance     Decimal   @default(0) @db.Decimal(12, 2)
    advance     Decimal   @default(0) @db.Decimal(12, 2)
    isClosed    Boolean   @default(false) @map("is_closed")
    createdAt   DateTime  @default(now()) @map("created_at")
    updatedAt   DateTime  @updatedAt @map("updated_at")
    expenses    Expense[]

    @@unique([userId, bank, closingDate], map: "card_invoices_user_bank_closing_date_unique")
    @@index([userId], map: "card_invoices_user_id_idx")
    @@map("card_invoices")
}

model Expense {
    id                 String       @id @default(uuid()) @db.Uuid
    userId             String       @map("user_id") @db.Uuid
    user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
    bank               String
    type               String
    category           String
    date               DateTime     @db.Date
    amount             Decimal      @db.Decimal(12, 2)
    description        String?
    receipt            String?
    installmentCurrent Int?         @map("installment_current")
    installmentTotal   Int?         @map("installment_total")
    cardInvoiceId      String?      @map("card_invoice_id") @db.Uuid
    cardInvoice        CardInvoice? @relation(fields: [cardInvoiceId], references: [id], onDelete: SetNull)
    createdAt          DateTime     @default(now()) @map("created_at")
    updatedAt          DateTime     @updatedAt @map("updated_at")

    @@index([userId], map: "expenses_user_id_idx")
    @@map("expenses")
}

model FixedExpense {
    id          String   @id @default(uuid()) @db.Uuid
    userId      String?  @map("user_id") @db.Uuid
    user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
    name        String
    amount      Decimal  @db.Decimal(12, 2)
    description String?
    dueDay      Int?     @map("due_day")
    isActive    Boolean  @default(true) @map("is_active")
    createdAt   DateTime @default(now()) @map("created_at")
    updatedAt   DateTime @updatedAt @map("updated_at")

    @@index([userId, isActive], map: "fixed_expenses_user_id_is_active_idx")
    @@map("fixed_expenses")
}
