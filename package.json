{
  "name": "keep-a-budget",
  "version": "7.5.0",
  "description": "Backend app responsible for keeping track of credit card invoice expenses",
  "main": "dist/main.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "prisma generate && node scripts/check-arch.mjs && nest build",
    "check:arch": "node scripts/check-arch.mjs",
    "start": "nest start --prod",
    "dev": "nest start --watch",
    "data:migrate-to-prod": "tsx scripts/migrate-to-prod.ts",
    "data:encrypt-users": "tsx scripts/encryptExistingUserData.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "test": "node --import tsx --test test/budget/invoice-period.spec.ts test/budget/upsert-budget.use-case.spec.ts test/budget/get-budget-summary.use-case.spec.ts test/budget/get-active-budget-summary.use-case.spec.ts"
  },
  "keywords": [],
  "overrides": {
    "fastify": "$fastify"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@aws-sdk/client-s3": "^3.1073.0",
    "@aws-sdk/lib-storage": "^3.1073.0",
    "@aws-sdk/s3-request-presigner": "^3.1073.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^11.0.0",
    "@fastify/static": "^9.1.3",
    "@nestjs/common": "^11.1.27",
    "@nestjs/core": "^11.1.27",
    "@nestjs/platform-fastify": "^11.1.27",
    "@nestjs/swagger": "^11.4.4",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "archiver": "^8.0.0",
    "brapi": "^1.0.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "fastify-plugin": "^6.0.0",
    "node-cron": "^4.4.1",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.14.0",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.23",
    "@types/archiver": "^8.0.0",
    "@types/aws-sdk": "^2.7.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.0.0",
    "prisma": "^7.8.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
