generator client {
    provider     = "prisma-client"
    output       = "../src/generated/prisma/client"
    moduleFormat = "cjs"
}

datasource db {
    provider = "postgresql"
}

enum InvoiceStatus {
    OPEN
    FUTURE
    CLOSED

    @@map("invoice_status")
}

enum FuelType {
    gasolina
    etanol
    flex
    diesel
    eletrico
    hibrido

    @@map("fuel_type")
}

model User {
    id                 String              @id @default(uuid()) @db.Uuid
    name               String
    lastName           String              @map("last_name")
    email              String              @unique
    cpf                String?             @unique @db.VarChar(11)
    rg                 String?
    rgHash             String?             @unique @map("rg_hash")
    phone              String?
    salary             String?
    avatar             String?
    lastLogin          DateTime?           @map("last_login")
    createdAt          DateTime            @default(now()) @map("created_at")
    updatedAt          DateTime            @updatedAt @map("updated_at")
    fixedExpense       FixedExpense[]
    sessions           UserSession[]
    expenses           Expense[]
    cardInvoices       CardInvoice[]
    irDocuments        IrDocument[]
    stockTransactions  StockTransaction[]
    budgets            Budget[]
    emailOtps          EmailOtp[]
    categories         Category[]
    vehicles           Vehicle[]
    extraIncomes       ExtraIncome[]
    paymentMethods     PaymentMethod[]

    @@map("users")
}

model UserSession {
    id        String    @id @default(uuid()) @db.Uuid
    userId    String    @map("user_id") @db.Uuid
    user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    tokenHash String    @unique @map("token_hash")
    deviceId  String?   @map("device_id")
    expiresAt DateTime  @map("expires_at")
    revokedAt DateTime? @map("revoked_at")
    userAgent String?   @map("user_agent")
    ipAddress String?   @map("ip_address")
    createdAt DateTime  @default(now()) @map("created_at")
    updatedAt DateTime  @updatedAt @map("updated_at")

    @@unique([userId, deviceId], map: "user_sessions_user_id_device_id_unique")
    @@index([userId], map: "user_sessions_user_id_idx")
    @@index([expiresAt], map: "user_sessions_expires_at_idx")
    @@map("user_sessions")
}

model CardInvoice {
    id          String    @id @default(uuid()) @db.Uuid
    userId      String    @map("user_id") @db.Uuid
    user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    bank        String
    closingDate DateTime  @map("closing_date") @db.Date
    dueDate     DateTime  @map("due_date") @db.Date
    balance     Decimal   @default(0) @db.Decimal(12, 2)
    advance     Decimal   @default(0) @db.Decimal(12, 2)
    status      InvoiceStatus @default(OPEN)
    createdAt   DateTime  @default(now()) @map("created_at")
    updatedAt   DateTime  @updatedAt @map("updated_at")
    expenses     Expense[]
    budgetLinks  BudgetCardInvoice[]

    @@unique([userId, bank, closingDate], map: "card_invoices_user_bank_closing_date_unique")
    @@index([userId], map: "card_invoices_user_id_idx")
    @@map("card_invoices")
}

model Expense {
    id                 String       @id @default(uuid()) @db.Uuid
    userId             String       @map("user_id") @db.Uuid
    user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
    bank               String
    type               String
    category           String
    date               DateTime     @db.Date
    amount             Decimal      @db.Decimal(12, 2)
    description        String?
    receipt            String?
    irDeductible       Boolean      @default(false) @map("ir_deductible")
    installmentCurrent Int?         @map("installment_current")
    installmentTotal   Int?         @map("installment_total")
    cardInvoiceId      String?      @map("card_invoice_id") @db.Uuid
    cardInvoice        CardInvoice? @relation(fields: [cardInvoiceId], references: [id], onDelete: SetNull)
    createdAt          DateTime     @default(now()) @map("created_at")
    updatedAt          DateTime     @updatedAt @map("updated_at")

    @@index([userId], map: "expenses_user_id_idx")
    @@map("expenses")
}

model FixedExpense {
    id          String   @id @default(uuid()) @db.Uuid
    userId      String?  @map("user_id") @db.Uuid
    user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
    name        String
    amount      Decimal  @db.Decimal(12, 2)
    description String?
    dueDay      Int?     @map("due_day")
    isActive    Boolean  @default(true) @map("is_active")
    createdAt   DateTime @default(now()) @map("created_at")
    updatedAt   DateTime @updatedAt @map("updated_at")

    @@index([userId, isActive], map: "fixed_expenses_user_id_is_active_idx")
    @@map("fixed_expenses")
}

model PaymentMethod {
    id         String   @id @default(uuid()) @db.Uuid
    userId     String   @map("user_id") @db.Uuid
    user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    name       String
    type       String
    color      String?
    closingDay Int?     @map("closing_day")
    dueDay     Int?     @map("due_day")
    isActive   Boolean  @default(true) @map("is_active")
    createdAt  DateTime @default(now()) @map("created_at")
    updatedAt  DateTime @updatedAt @map("updated_at")

    @@unique([userId, name], map: "payment_methods_user_name_unique")
    @@index([userId, isActive], map: "payment_methods_user_id_is_active_idx")
    @@map("payment_methods")
}

model ExtraIncome {
    id          String   @id @default(uuid()) @db.Uuid
    userId      String   @map("user_id") @db.Uuid
    user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    description String
    amount      Decimal  @db.Decimal(12, 2)
    date        DateTime @db.Date
    createdAt   DateTime @default(now()) @map("created_at")
    updatedAt   DateTime @updatedAt @map("updated_at")

    @@index([userId, date], map: "extra_incomes_user_id_date_idx")
    @@map("extra_incomes")
}

model IrDocument {
    id          String   @id @default(uuid()) @db.Uuid
    userId      String   @map("user_id") @db.Uuid
    user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    date        DateTime @db.Date
    category    String
    amount      Decimal  @db.Decimal(12, 2)
    description String?
    receipt     String
    year        Int
    createdAt   DateTime @default(now()) @map("created_at")
    updatedAt   DateTime @updatedAt @map("updated_at")

    @@index([userId, year], map: "ir_documents_user_id_year_idx")
    @@map("ir_documents")
}

enum StockTransactionType {
    COMPRA
    VENDA

    @@map("stock_transaction_type")
}

enum StockOperationType {
    NORMAL
    DAY_TRADE

    @@map("stock_operation_type")
}

model StockTransaction {
    id            String               @id @default(uuid()) @db.Uuid
    userId        String               @map("user_id") @db.Uuid
    user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
    ticker        String
    companyName   String               @map("company_name")
    cnpj          String?
    broker        String
    date          DateTime             @db.Date
    type             StockTransactionType
    operationType    StockOperationType   @map("operation_type")
    quantity         Decimal              @db.Decimal(18, 6)
    unitPrice        Decimal              @map("unit_price") @db.Decimal(12, 4)
    fees             Decimal              @db.Decimal(12, 2)
    isOpeningBalance Boolean              @default(false) @map("is_opening_balance")
    noteFile         String?              @map("note_file")
    year             Int
    createdAt     DateTime             @default(now()) @map("created_at")
    updatedAt     DateTime             @updatedAt @map("updated_at")

    @@index([userId, year], map: "stock_transactions_user_id_year_idx")
    @@map("stock_transactions")
}

model Budget {
    id           String              @id @default(uuid()) @db.Uuid
    userId       String              @map("user_id") @db.Uuid
    user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
    category     String
    amount       Decimal             @db.Decimal(12, 2)
    month        Int
    year         Int
    createdAt    DateTime            @default(now()) @map("created_at")
    updatedAt    DateTime            @updatedAt @map("updated_at")
    cardInvoices BudgetCardInvoice[]

    @@unique([userId, category, month, year], map: "budgets_user_category_month_year_unique")
    @@index([userId, year, month], map: "budgets_user_id_year_month_idx")
    @@map("budgets")
}

model BudgetCardInvoice {
    id            String      @id @default(uuid()) @db.Uuid
    budgetId      String      @map("budget_id") @db.Uuid
    budget        Budget      @relation(fields: [budgetId], references: [id], onDelete: Cascade)
    cardInvoiceId String      @map("card_invoice_id") @db.Uuid
    cardInvoice   CardInvoice @relation(fields: [cardInvoiceId], references: [id], onDelete: Cascade)
    bank          String

    @@unique([budgetId, bank], map: "budget_card_invoices_budget_bank_unique")
    @@map("budget_card_invoices")
}

model Category {
    id        String   @id @default(uuid()) @db.Uuid
    userId    String   @map("user_id") @db.Uuid
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    name      String
    icon      String
    isDefault Boolean  @default(false) @map("is_default")
    isHidden  Boolean  @default(false) @map("is_hidden")
    sortOrder Int      @default(0) @map("sort_order")
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    @@unique([userId, name], map: "categories_user_id_name_unique")
    @@index([userId], map: "categories_user_id_idx")
    @@map("categories")
}

model EmailOtp {
    id         String    @id @default(uuid()) @db.Uuid
    userId     String    @map("user_id") @db.Uuid
    user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    codeHash   String    @unique @map("code_hash")
    attempts   Int       @default(0)
    expiresAt  DateTime  @map("expires_at")
    consumedAt DateTime? @map("consumed_at")
    createdAt  DateTime  @default(now()) @map("created_at")

    @@index([userId], map: "email_otps_user_id_idx")
    @@index([expiresAt], map: "email_otps_expires_at_idx")
    @@map("email_otps")
}

model Vehicle {
    id              String    @id @default(uuid()) @db.Uuid
    userId          String    @map("user_id") @db.Uuid
    user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    plate           String
    brand           String
    model           String
    yearManufacture Int       @map("year_manufacture")
    renavam         String?
    chassis         String?
    yearModel       Int?      @map("year_model")
    color           String?
    fuel            FuelType?
    ipvaExpiry      DateTime? @map("ipva_expiry") @db.Date
    ipvaValue       Decimal?  @map("ipva_value") @db.Decimal(12, 2)
    insuranceExpiry DateTime? @map("insurance_expiry") @db.Date
    licensingExpiry DateTime? @map("licensing_expiry") @db.Date
    currentKm       Int?      @map("current_km")
    lastServiceDate DateTime? @map("last_service_date") @db.Date
    nextOilChangeKm Int?      @map("next_oil_change_km")
    notes           String?
    photoUrl        String?   @map("photo_url")
    createdAt       DateTime  @default(now()) @map("created_at")
    updatedAt       DateTime  @updatedAt @map("updated_at")

    @@unique([userId, plate], map: "vehicles_user_id_plate_unique")
    @@index([userId], map: "vehicles_user_id_idx")
    @@map("vehicles")
}
